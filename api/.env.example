# ============================================
# Localize Sua Saúde - Backend (EXEMPLO)
# ============================================
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env real!

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Banco de Dados ---
DB_NOME=landing.db
DB_DIRETORIO=./db
DB_WAL=true
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHAVE_CRIPTO_BANCO=<gerar_aleatoria>

# --- Chaves de Acesso da API ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_PUBLICA=<gerar_aleatoria>
API_KEY_ADMIN=<gerar_aleatoria>

# --- Segurança ---
CHAVE_SESSAO=<gerar_64_bytes_hex>
JWT_SECRETO=<gerar_aleatoria>
JWT_EXPIRACAO=24h

# --- CORS ---
ORIGEM_PERMITIDA=http://localhost:3000

# --- APIs Externas ---
VIACEP_URL=https://viacep.com.br/ws

# --- Rate Limiting ---
RATE_LIMIT_JANELA_MS=900000
RATE_LIMIT_MAX_REQUISICOES=100

# --- Admin Padrão ---
ADMIN_EMAIL=admin@exemplo.com
ADMIN_SENHA=<definir_senha_forte>
