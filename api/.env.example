# ============================================
# Localize Sua Saúde - Backend (EXEMPLO)
# ============================================
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env real!
# Gere chaves com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Servidor ---
PORT=3000

# --- Chaves de Acesso da API (mínimo 32 caracteres — validado no startup) ---
# API_KEY_ADMIN: leitura administrativa (GET /api/leads) — SOMENTE backend
API_KEY_ADMIN=<gerar_aleatoria>
# API_KEY_PUBLICA: escrita máquina-a-máquina (POST com header x-api-key)
API_KEY_PUBLICA=<gerar_aleatoria>

# --- CORS / Origens ---
ORIGEM_PERMITIDA=http://localhost:3000
# Origens que podem fazer POST sem chave (separadas por vírgula)
ORIGENS_CONFIAVEIS=http://localhost:3000,http://localhost:5173

# --- Rate Limiting ---
RATE_LIMIT_JANELA_MS=900000
RATE_LIMIT_MAX_REQUISICOES=100
