# ============================================================
# Localize Sua Saude -- Variaveis de Ambiente (EXEMPLO)
# ============================================================
# 1. Copie este arquivo: cp .env.example .env
# 2. Gere chaves seguras com o comando abaixo e substitua os campos CHANGE_ME:
#    node -e "const c=require('crypto');console.log(c.randomBytes(48).toString('hex'))"
# 3. NUNCA envie o arquivo .env para o Git (ja esta no .gitignore).
# O servidor NAO iniciara sem estas variaveis configuradas corretamente.

# --- Servidor ---
PORT=3000
NODE_ENV=development
DB_PATH=./db/saude.db

# --- Segredos (minimo 32 caracteres cada, use randomBytes para gerar) ---
JWT_SECRET=CHANGE_ME_gere_com_node_randomBytes_48
API_KEY_ADMIN=CHANGE_ME_gere_com_node_randomBytes_32
API_KEY_PUBLICA=CHANGE_ME_gere_com_node_randomBytes_32

# --- CORS & Comunicacao ---
ORIGEM_PERMITIDA=http://localhost:5173
ORIGENS_CONFIAVEIS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_JANELA_MS=900000
RATE_LIMIT_MAX_REQUISICOES=100

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:3000/api
